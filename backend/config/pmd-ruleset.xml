<?xml version="1.0" encoding="UTF-8"?>
<!-- PMD rules for Project Pulse: PMD's quickstart set, minus the rules the team has decided not to
     enforce. To drop a rule, add an exclude inside the quickstart reference, with a comment giving
     the reason, for example:

       <exclude name="ControlStatementBraces"/>

     To add a rule from outside quickstart, add its own <rule ref="category/java/..."/> line.
     Every change here is a reviewed decision. -->
<ruleset name="Project Pulse"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD quickstart, with Project Pulse's decisions.</description>
    <rule ref="rulesets/java/quickstart.xml">
        <!-- D2: UncommentedEmptyConstructor is off. The rule asks for a comment so an empty constructor
             is not mistaken for unfinished work. In Project Pulse 26 of its 30 findings are JPA entities,
             where the spec requires a no-arg constructor (Hibernate instantiates through it, then sets
             the fields), so an empty body is the expected shape and a comment in each adds nothing.
             Of the other four, PeerEvaluationAverage and WeeklyPeerEvaluationReport lose the constructor
             under UnnecessaryConstructor below; Result and RatingAverage keep an unused no-arg
             constructor, which is a dead-code question, not a missing-comment one.
             The other half of D2, UnnecessaryConstructor, stays enforced: an empty no-arg constructor
             that is a class's only constructor is the one Java generates anyway, so it can be deleted. -->
        <exclude name="UncommentedEmptyConstructor"/>
        <!-- D3: ControlStatementBraces stays enforced (no exclude). Its findings are one-line guard
             clauses, several in security- and lock-sensitive code (UserUtils resolves the caller's id
             and role; DocumentSectionLock and UseCaseLock decide whether an edit lease has lapsed).
             A line later added under a brace-less guard silently runs unconditionally, and the rest of
             the codebase already braces every block, so the fix is mechanical and matches house style. -->
        <!-- D4: GuardLogStatement is off. A guard only saves evaluating a log call's arguments when its
             level is disabled. All Project Pulse logging goes through SLF4J with {} placeholders and no
             string concatenation, so no message is built unless the level is on, and the flagged
             arguments are plain getters and size() calls. One of the four findings
             (ReminderService) is an error-level log in a catch block, which is always on, so a guard
             there could never skip anything. Accepted trade-off: a future expensive argument
             (e.g. toJson() in a debug log) will not be flagged by this rule. -->
        <exclude name="GuardLogStatement"/>
    </rule>
</ruleset>
